# Copy this file to .env and fill in your own values.

# --- Security ---------------------------------------------------------
# Any random string. The frontend must send this exact value as the
# 'X-API-Key' header on every request. Generate one with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-set-a-real-key-here

# Comma-separated list of origins allowed to call this API from a browser.
# Add your Lovable app's published URL here once you have it.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- LLM (required for relevance scoring + CV/cover letter tailoring) --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Job sources (all optional -- missing ones are just skipped) -------
# Free key: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Free key: https://jooble.org/api/about
JOOBLE_API_KEY=

# Free tier: https://serpapi.com/ -- powers on-demand internet-wide job
# search (POST /api/jobs/search-web), via SerpApi's Google Jobs engine.
SERPAPI_KEY=

# Optional manual override for the UK Home Office sponsor register CSV
# link, only needed if gov.uk restructures their publication page and
# auto-discovery (POST /api/sources/uk-sponsor-register/refresh) breaks.
# Leave blank normally.
UK_SPONSOR_REGISTER_CSV_URL=

# --- Scheduler ----------------------------------------------------------
ENABLE_SCHEDULER=true
DAILY_FETCH_HOUR=18
DAILY_FETCH_MINUTE=0
